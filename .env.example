# Codebase 2D — example environment. Copy to a real `.env` and fill in; never
# commit one. Each variable below is read by exactly one side of the app.
#
# --- Frontend (build-time) ---
# Vite bakes `import.meta.env.VITE_API_URL` into the bundle at build time
# (frontend/src/api/client.ts). On Vercel this is a project env var; empty means
# same-origin `/api`, which only the Vite dev-server proxy can serve.
VITE_API_URL=

# --- Backend (backend/app/config.py; unrelated keys are ignored) ---
# JSON array naming the exact origin(s) allowed to call the API from a browser
# (ADR-028). Empty allows nothing cross-origin — correct for local dev, where
# the Vite dev server proxies /api. Example:
#   CORS_ALLOWED_ORIGINS=["https://codebase-2d.vercel.app"]
CORS_ALLOWED_ORIGINS=

# Optional; raises GitHub's API rate limits on repo metadata. Never sent to the
# archive host (ADR-009).
GITHUB_TOKEN=